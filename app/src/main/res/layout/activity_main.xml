<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#101B2D">

    <TextView
        android:id="@+id/txt_titre_tb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOUANE TEMPORELLE"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/et_nom_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom du voyageur"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"
        android:inputType="textPersonName"/>

-    <EditText
        android:id="@+id/et_naissance_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Annee de naissance"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"/>

    <EditText
        android:id="@+id/et_destination_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Annee de destination"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"/>

    <TextView
        android:id="@+id/txt_motif_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motif du voyage"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="15dp"/>

    <Spinner
        android:id="@+id/sp_motif_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btn_inspecter_tb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inspecter le profil"
        android:layout_marginTop="25dp"/>

</LinearLayout>